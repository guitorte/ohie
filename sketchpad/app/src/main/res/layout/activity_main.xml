<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.guitorte.sketchpad.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/drawing_canvas" />

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <!-- Retracts out of the way; the action bar below never does. -->
        <LinearLayout
            android:id="@+id/toolPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/colorRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.slider.Slider
                android:id="@+id/sizeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brush_size"
                android:stepSize="1"
                android:value="12"
                android:valueFrom="2"
                android:valueTo="60" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photoButton"
                style="@style/Widget.Sketchpad.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/load_photo"
                app:icon="@drawable/ic_photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/paletteButton"
                style="@style/Widget.Sketchpad.IconButton.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:contentDescription="@string/toggle_tools"
                app:icon="@drawable/ic_palette" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/eraserButton"
                style="@style/Widget.Sketchpad.IconButton.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:contentDescription="@string/eraser"
                app:icon="@drawable/ic_eraser" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/laserButton"
                style="@style/Widget.Sketchpad.IconButton.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:contentDescription="@string/laser"
                app:icon="@drawable/ic_laser" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panButton"
                style="@style/Widget.Sketchpad.IconButton.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:contentDescription="@string/pan_zoom"
                app:icon="@drawable/ic_pan" />

            <!-- Keeps everything after it against the right edge, in thumb reach. -->
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/undoButton"
                style="@style/Widget.Sketchpad.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/undo"
                app:icon="@drawable/ic_undo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/redoButton"
                style="@style/Widget.Sketchpad.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/redo"
                app:icon="@drawable/ic_redo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/moreButton"
                style="@style/Widget.Sketchpad.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/more_actions"
                app:icon="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
